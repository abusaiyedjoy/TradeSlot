# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/tradeslot?schema=public"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Stripe Connect & Payments
# Get from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_51...
# Get from Stripe CLI or Dashboard Webhooks (https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Inbound Channel: WhatsApp Cloud API (Optional for local testing / mockable)
# Get from Meta Developers Console (https://developers.facebook.com)
WHATSAPP_API_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=100...
WHATSAPP_VERIFY_TOKEN=tradeslot-verify

# Billing & Platform Fee Defaults (in cents)
PLATFORM_FEE_CENTS=500
PLACEHOLDER_JOB_PRICE_CENTS=5000
